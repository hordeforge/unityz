# Every optional shellcheck check the tree already passes, on by default so a
# bare `shellcheck scripts/*.sh` locally enforces exactly what CI enforces.
# Most of these catch real defects the default set lets through: exit codes
# masked inside a command substitution, `set -e` silently suppressed by
# calling a function in a condition, a `case` with no fallback arm, an
# unquoted expansion, a typo'd uppercase variable.
enable=add-default-case
enable=avoid-negated-conditions
enable=avoid-nullary-conditions
enable=check-extra-masked-returns
enable=check-set-e-suppressed
enable=check-unassigned-uppercase
enable=deprecate-which
enable=quote-safe-variables
enable=require-double-brackets
enable=useless-use-of-cat

# require-variable-braces (SC2250) is deliberately left off: the scripts here
# use bare "$var" throughout, and it is cosmetic only.
